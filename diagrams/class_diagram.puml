@startuml class_diagram

''!theme vibrant

title Structural Diagram - Motor Control HAL

note as N1
  This is not a traditional class diagram as the HAL is written in C-style, not C++.
  The diagram shows the central MotorContext data structure and the functions that operate on it, organized by file.
end note

package "src/motor_control_hal_rp2040_types_constants.h" {
  class MotorContext <<struct>> {
    + is_initialized: bool
    + skip_measurement: bool
    -- Pins --
    + pwm_a_pin: uint8_t
    + pwm_b_pin: uint8_t
    + bemf_a_pin: uint8_t
    + bemf_b_pin: uint8_t
    -- PWM --
    + motor_pwm_slice_a: uint
    + motor_pwm_slice_b: uint
    + pwm_wrap_value: uint16_t
    + next_duty_level_a: uint16_t
    + next_duty_level_b: uint16_t
    + pwm_frequency: uint32_t
    -- BEMF --
    + bemf_mode: BEMFMode
    + bemf_measurement_delay_us: uint32_t
    + bemf_samples_to_take: uint8_t
    + bemf_samples_taken: uint8_t
    + alarm_id: int
    + dma_channel_bemf: int
    + bemf_ring_buffer: volatile uint16_t[]
    + bemf_callback: hal_bemf_update_callback_t
    + alarm_user_data: AlarmUserData
  }

  class AlarmUserData <<struct>> {
    + ctx: MotorContext*
  }

  enum BEMFMode {
    BEMF_MODE_NONE
    BEMF_MODE_DMA
    BEMF_MODE_IRQ
    BEMF_MODE_TIMER_ADC
  }

  MotorContext *-- AlarmUserData
  MotorContext *-- BEMFMode
}

package "src/motor_control_hal.h" {
  interface "Public API" as PublicAPI {
    + hal_motor_init_pwm(...)
    + hal_motor_init_bemf_adc(...)
    + hal_motor_init_bemf_dma(...)
    + hal_motor_init_bemf_timer_adc(...)
    + hal_motor_set_duty(...)
    + hal_motor_get_bemf_buffer(...)
    + hal_motor_check_solenoid_position(...)
  }
}

package "src/motor_control_hal_rp2040.cpp" {
    note "Includes all .cpp.inc files" as N2
}

package "src/motor_control_hal_rp2040_motor.cpp.inc" {
    class motor_impl as "motor.cpp.inc" {
        + hal_motor_init_bemf_adc(...)
        + hal_motor_set_duty(...)
        + hal_motor_get_bemf_buffer(...)
    }
}

package "src/motor_control_hal_rp2040_pwm.cpp.inc" {
    class pwm_impl as "pwm.cpp.inc" {
        + hal_motor_init_pwm(...)
        - on_pwm_wrap()
        - pwm_init_common()
    }
}

package "src/motor_control_hal_rp2040_adc.cpp.inc" {
    class adc_impl as "adc.cpp.inc" {
        - adc_init_common()
        - trigger_adc_measurement()
        - delayed_adc_trigger_callback()
    }
}

package "src/motor_control_hal_rp2040_dma.cpp.inc" {
    class dma_impl as "dma.cpp.inc" {
        + hal_motor_init_bemf_dma(...)
    }
}

package "src/motor_control_hal_rp2040_timer_adc.cpp.inc" {
    class timer_adc_impl as "timer_adc.cpp.inc" {
        + hal_motor_init_bemf_timer_adc(...)
        - delayed_adc_trigger_callback()
    }
}
timer_adc_impl --> MotorContext : (modifies)

package "src/motor_control_hal_rp2040_irq.cpp.inc" {
    class irq_impl as "irq.cpp.inc" {
        - on_pwm_wrap()
        - adc_irq_handler()
    }
}

package "src/motor_control_diagnostics.cpp" {
    class diag_impl as "diagnostics.cpp" {
        + hal_motor_check_solenoid_position(...)
    }
}


PublicAPI --> MotorContext : (modifies)
motor_impl --> MotorContext : (modifies)
pwm_impl --> MotorContext : (modifies)
adc_impl --> MotorContext : (modifies)
dma_impl --> MotorContext : (modifies)
irq_impl --> MotorContext : (modifies)
diag_impl --> MotorContext : (modifies)


@enduml
